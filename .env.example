# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/directive_2023_970
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=1h
PSEUDONYMIZATION_SALT=directive-2023-970-salt-change-this

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api
VERCEL_URL=

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
DEBUG=false

# ============================================================================
# DIRECTIVE 2023/970 & GDPR COMPLIANCE
# ============================================================================
# Minimum group size for pay gap analysis (Directive Article 5)
MIN_GROUP_SIZE=10

# Employee transparency response deadline (Directive Article 10)
TRANSPARENCY_RESPONSE_DAYS=15

# Data retention period (recommend 3 years per GDPR)
DATA_RETENTION_YEARS=3

# ============================================================================
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# ============================================================================
# SENTRY_DSN=
# DATADOG_API_KEY=
# SLACK_WEBHOOK_URL=

# ============================================================================
# NOTES
# ============================================================================
# 1. Change JWT_SECRET and PSEUDONYMIZATION_SALT for production
# 2. Use strong PostgreSQL credentials
# 3. DATABASE_URL format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
# 4. All sensitive values should be stored in environment-specific .env files
# 5. Never commit actual .env files to version control
